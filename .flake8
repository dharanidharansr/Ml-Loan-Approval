[flake8]
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .coverage,
    htmlcov,
    dist,
    build,
    *.egg-info,
    .tox,
    .venv,
    venv,
    env,
    ml,
    .github,
    node_modules,
    templates,
    static

max-line-length = 127
max-complexity = 10

ignore = 
    E203,
    W503,
    E501

select = E,W,F,C,N
show-source = True
count = True
statistics = True
